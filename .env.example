# Copy to .env locally. NEVER commit a real .env, and NEVER put real Stripe keys in git.
PORT=3000
NODE_ENV=development
# Render sets DATABASE_URL from its Postgres service. Locally, leave unset to use data/nexus.json.
DATABASE_URL=
# Generate a long random string for production. Render's render.yaml generates one for SESSION_SECRET.
SESSION_SECRET=change-me-to-a-long-random-string
# Stripe — PLACEHOLDERS ONLY in this build. Real keys only after the owner connects Stripe.
STRIPE_MODE=test
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
